# LLM API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
XAI_API_KEY=your-xai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
MOONSHOT_API_KEY=your-moonshot-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Ollama (Local LLM & Cloud)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CLOUD_API_KEY=your-ollama-cloud-api-key

# Claude Agent SDK mode
# Select the "Claude Agent SDK" provider via /model — no API key entry is required
# here; the SDK resolves credentials itself (Claude Code login / CLAUDE_CODE_OAUTH_TOKEN
# / ANTHROPIC_API_KEY). See README "Claude Agent SDK モード".
# If a usage-based credential path (ANTHROPIC_API_KEY / CLAUDE_CODE_USE_BEDROCK /
# CLAUDE_CODE_USE_VERTEX / ...) is present in the environment, the mode stops before
# running and reports it. Set this to 1 to explicitly proceed on that path.
DEXTER_AGENT_SDK_ALLOW_METERED=0
# Optional client-side cost ceiling (USD) for Claude Agent SDK mode; the SDK stops
# when its estimate reaches this value. Leave unset for no ceiling.
# DEXTER_AGENT_SDK_MAX_BUDGET_USD=1.00

# Persistent memory embeddings reuse existing model API keys.
# Priority: OpenAI (OPENAI_API_KEY) -> Gemini (GOOGLE_API_KEY) -> Ollama (OLLAMA_BASE_URL)
# No additional memory-specific API keys required.

# EDINET DB API Key (Japanese financial data — required)
# Get your API key at https://edinetdb.jp
EDINETDB_API_KEY=your-edinetdb-api-key

# J-Quants API (optional — enables stock price data from Tokyo Stock Exchange)
# Get your API key at https://jpx-jquants.com (Dashboard → API Keys)
# V2 API: no expiry, no token refresh needed
JQUANTS_API_KEY=your-jquants-api-key

# Messaging Channels (optional, for bun run gateway)

# Slack (Socket Mode, no public URL needed)
# Create app: api.slack.com/apps, enable Socket Mode + Event Subscriptions
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_APP_TOKEN=your-slack-app-token

# Discord (Gateway, no public URL needed)
# Create bot: discord.com/developers/applications
# Enable "Message Content Intent" in Bot → Privileged Gateway Intents
DISCORD_BOT_TOKEN=your-discord-bot-token

# LINE (requires webhook URL, use ngrok or deploy to cloud)
# Create channel: developers.line.biz/console/
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
WEBHOOK_PORT=3000

# Web Search API Keys (Exa → Perplexity → Tavily → LangSearch)
EXASEARCH_API_KEY=your-exa-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key
TAVILY_API_KEY=your-tavily-api-key
LANGSEARCH_API_KEY=your-langsearch-api-key

# X/Twitter API (enables x_search tool for public sentiment research)
X_BEARER_TOKEN=your-X-bearer-token

# LangSmith
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=dexter-jp
LANGSMITH_TRACING=false

# ---------------------------------------------------------------------------
# 答え合わせ（v1.1.0-jp）
# ---------------------------------------------------------------------------

# 判定層（TypeSafe の Jev）。**これが無いと /check は走りません。**
# /check の入口には、売買や株価の水準についての助言を求める入力を判定に進めない検査が
# あります。この検査は「決まった語彙と言い回し」と「判定層の票」の 2 つでできていて、
# 手元の LLM にラベルだけ代行させる構成では、固定評価集合 30 本のうち 8 本が素通りします。
# 取りこぼしたまま動かすより止まる方を選んでいるので、鍵なしでは /check は案内を出して終わります。
# 鍵を入れる前に動きを見るなら: DEXTER_SKIP_BROWSER=1 bun install && bun run demo
TYPESAFE_API_KEY=your-typesafe-api-key

# bun install のときに Chromium（130MB 超）を落とさない。
# browser ツールを使うときだけ、この行を外して bun install し直してください。
DEXTER_SKIP_BROWSER=1
