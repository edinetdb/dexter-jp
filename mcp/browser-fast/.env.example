# Jev operation/target model (required)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# OpenAI-compatible text helper used only for safe TYPE_TEXT actions (required)
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Optional browser-fast runtime limits
BROWSER_FAST_TOTAL_TIMEOUT_SECONDS=180
BROWSER_FAST_MODEL_TIMEOUT_SECONDS=25
# BROWSER_FAST_TRACE_DIR=C:\path\to\private\traces
